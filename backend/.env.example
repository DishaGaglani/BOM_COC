# Copy to .env (gitignored) for local `uvicorn app.main:app --reload` runs
# without Docker. app/config.py's Settings loads .env automatically.

# forjinn.com-hosted flow (Qwen-based agent) for semantic field extraction
# and COC-vs-BOM comparison — see app/services/forjinn_client.py. Same value
# already hardcoded in ../docker-compose.yml. Unset to disable extraction
# entirely (BOM/COC ingestion will raise).
BOMCOC_FORJINN_API_URL=https://forjinn.com/api/v1/prediction/23715a87-e685-4ed3-9f07-98aeb705233a

# Uncomment if forjinn's endpoint ends up requiring an API key — unconfirmed
# as of writing (see forjinn_client.py's module docstring).
# BOMCOC_FORJINN_API_KEY=
